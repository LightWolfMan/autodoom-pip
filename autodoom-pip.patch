@@ -0,0 +1,64 @@
+// Emacs style mode select   -*- C++ -*-
+//-----------------------------------------------------------------------------
+//
+// Copyright (C) 2026 AutoDoom contributors
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+//--------------------------------------------------------------------------
+//
+// DESCRIPTION:
+//   Exit voting. No bot takes the exit on its own: it calls a vote, everyone
+//   answers according to how done they think the level is, and the exit only
+//   opens on a majority. A refused vote buys the level another minute.
+//
+//-----------------------------------------------------------------------------
+
+#ifndef B_VOTE_H__
+#define B_VOTE_H__
+
+// Liga o sistema. Com 0, os bots saem quando quiserem, como antes.
+// 1 = jogadores se ferem no coop, como no Doom classico.
+extern int bot_friendlyfire;
+
+extern int bot_exitvote;
+
+// Segundos de espera depois de uma votacao recusada.
+extern int bot_exitvote_delay;
+
+// 1 grava o que acontece em vote.log, ao lado do executavel. Desligado por
+// padrao: e ferramenta de diagnostico, nao deve sujar a pasta de quem so joga.
+extern int bot_exitvote_log;
+
+struct line_t;
+
+// A linha termina o mapa?
+bool B_LineIsExit(const line_t &line);
+
+// O exito ja foi autorizado nesta partida?
+bool B_ExitApproved();
+
+// Um bot quer sair. Pergunta ao jogador se ninguem estiver perguntando e o
+// tempo de espera tiver passado. Devolve true se a saida ja esta liberada.
+bool B_RequestExitVote(int playernum);
+
+// Chamado a cada tic pelo laco do jogo.
+void B_VoteTicker();
+
+// Zera tudo na entrada do mapa.
+void B_VoteMapInit();
+
+// Resposta pelos comandos de console, alternativa ao dialogo.
+void B_CastHumanVote(bool yes);
+
+#endif
+
+// EOF
diff --git a/source/d_main.cpp b/source/d_main.cpp
index 1a6e8939..2d2b4694 100644
--- a/source/d_main.cpp
+++ b/source/d_main.cpp
@@ -79,6 +79,13 @@
 #include "p_setup.h"
 #include "r_draw.h"
 #include "r_main.h"
+#include "e_weapons.h"
+#include "e_inventory.h"
+#include "r_state.h"
+#include "m_vector.h"
+#include "p_maputl.h"
+#include "ev_actions.h"
+#include "ev_specials.h"
 #include "r_patch.h"
 #include "s_sound.h"
 #include "st_stuff.h"
@@ -577,6 +584,187 @@ void D_DrawWings()
 // Desenha o quadrinho com a visao de outro jogador. Chamado depois da view
 // principal e antes do HUD, que fica por cima de proposito.
 //
+//
+// Posicao da saida do mapa, para o criterio "quem esta mais perto de sair".
+//
+// Calculada uma vez por mapa: percorre as linhas procurando os specials de
+// saida -- os mesmos que o bot reconhece em b_think -- e devolve o ponto medio
+// das que achou. Sem saida encontrada (mapa de fim de episodio, saida por
+// script), devolve false e o criterio cai de volta para o de abates.
+//
+static bool D_findExit(v2fixed_t &out)
+{
+   static int     cachedLevelTic = -1;
+   static bool    cachedFound;
+   static v2fixed_t cachedPos;
+
+   if(cachedLevelTic == levelstarttic)
+   {
+      out = cachedPos;
+      return cachedFound;
+   }
+
+   int64_t sumx = 0, sumy = 0;
+   int     count = 0;
+
+   for(int i = 0; i < numlines; i++)
+   {
+      const line_t &line = lines[i];
+      if(!line.special)
+         continue;
+
+      const ev_action_t *action = EV_ActionForSpecialOrGen(line.special);
+      if(!action)
+         continue;
+
+      const EVActionFunc func = action->action;
+      if(func != EV_ActionExitLevel        && func != EV_ActionSwitchExitLevel &&
+         func != EV_ActionGunExitLevel     && func != EV_ActionParamExitNormal &&
+         func != EV_ActionSecretExit       && func != EV_ActionSwitchSecretExit &&
+         func != EV_ActionParamExitSecret  && func != EV_ActionTeleportNewMap  &&
+         func != EV_ActionTeleportEndGame)
+      {
+         continue;
+      }
+
+      sumx += (line.v1->x + line.v2->x) / 2;
+      sumy += (line.v1->y + line.v2->y) / 2;
+      count++;
+   }
+
+   cachedLevelTic = levelstarttic;
+   cachedFound    = count > 0;
+   if(cachedFound)
+   {
+      cachedPos.x = static_cast<fixed_t>(sumx / count);
+      cachedPos.y = static_cast<fixed_t>(sumy / count);
+   }
+
+   out = cachedPos;
+   return cachedFound;
+}
+
+//
+// Moldura do quadrinho, na cor do jogador que aparece nele, mais um micro HUD
+// com vida, colete e municao.
+//
+// A cor NAO pode ser uma tabelinha chutada por indice: o primeiro tento pintava
+// de vermelho um bot que estava bege. Ela sai da mesma `translationtables` que
+// recolore o sprite do jogador -- traduzindo um indice da rampa verde original,
+// a moldura fica exatamente na cor que se ve andando na tela.
+//
+// Levar dano pisca a moldura de branco, acompanhando `damagecount`, que e o
+// contador do clarao vermelho de quem apanha.
+//
+// Espessura da moldura, acompanhando a resolucao com piso alto o bastante para
+// nao sumir numa tela grande.
+static int D_pipThickness()
+{
+   int t = video.width / 320;
+   if(t < 5)
+      t = 5;
+   if(t > 12)
+      t = 12;
+   return t;
+}
+
+static void D_drawPipFrame(const player_t &player, int x, int y, int w, int h)
+{
+   // Indice no meio da rampa verde do jogador; a traducao leva para a cor dele.
+   static const byte greenRampSample = 0x77;
+
+   byte color = greenRampSample;
+   if(player.colormap > 0 && translationtables)
+      color = translationtables[player.colormap - 1][greenRampSample];
+
+   if(player.damagecount > 0)
+      color = GameModeInfo->whiteIndex;
+
+   const int t = D_pipThickness();
+
+   V_ColorBlock(&vbscreen, color, x - t, y - t, w + 2 * t, t);
+   V_ColorBlock(&vbscreen, color, x - t, y + h, w + 2 * t, t);
+   V_ColorBlock(&vbscreen, color, x - t, y,     t, h);
+   V_ColorBlock(&vbscreen, color, x + w, y,     t, h);
+}
+
+//
+// Micro HUD dentro do quadrinho: vida, colete e municao da arma na mao.
+//
+// Escrito direto no buffer de tela, em pixels reais -- a fonte do HUD tem 8
+// pixels de altura, entao numa tela grande fica pequena, que e exatamente o que
+// se quer de um canto de tela.
+//
+static void D_drawPipHud(const player_t &player, int x, int y, int w, int h)
+{
+   extern vfont_t *hud_font;   // vive em hu_stuff.cpp, sem header proprio
+
+   if(!hud_font || !player.mo)
+      return;
+
+   int ammo = -1;
+   if(player.readyweapon && player.readyweapon->ammo)
+      ammo = E_GetItemOwnedAmount(&player, player.readyweapon->ammo);
+
+   // So vida e municao: e legenda de canto, nao painel. O colete saiu porque
+   // era o dado que menos muda o que se ve acontecendo na tela do bot.
+   qstring text;
+   text << player.health << " HP";
+   if(ammo >= 0)
+      text << "   " << ammo << " AMMO";
+
+   // A cor do texto acompanha a do jogador, igual a moldura: com dois ou tres
+   // quadrinhos na tela, a legenda pertence visualmente ao quadro certo.
+   // Doom tem quatro cores de jogador, na ordem dos slots.
+   // Pelo `colormap`, a mesma fonte de verdade da moldura -- e nao pelo numero
+   // do slot, que nao diz nada sobre a cor com que o jogador aparece.
+   static const int playerTextColor[] = { CR_GREEN, CR_GRAY, CR_BROWN, CR_RED };
+   const int shade = player.colormap >= 0 && player.colormap < 4 ? player.colormap : 0;
+   const int color = playerTextColor[shade];
+
+   // Fonte do console: mais estreita que a do HUD, que e o que se quer numa
+   // legenda de canto.
+   extern vfont_t *c_font;
+   vfont_t *font = c_font ? c_font : hud_font;
+
+   // O `vbscreen` trabalha em coordenadas de 320x200 e escala sozinho -- passar
+   // pixel real fazia o texto cair fora da tela. E o `subscreen43` nao serve:
+   // ele cobre so a area 4:3 do meio, entao um quadrinho encostado na borda
+   // esquerda cai na tarja lateral e o texto sai cortado.
+   const int t   = D_pipThickness();
+   const int gap = t + 2;
+
+   // Embaixo do quadro, fora da imagem. Se nao couber (fila de baixo), sobe
+   // para cima do quadro em vez de sumir na borda da tela.
+   const int belowPhys = y + h + gap;
+   const int textPhys  = belowPhys + 12 < video.height ? belowPhys
+                                                       : y - gap - 12;
+
+   // Meio termo de tamanho: em 320x200 a fonte sai gigante numa tela grande, e
+   // em pixel nativo sai minuscula. Uma tela virtual de 640x400 deixa a fonte na
+   // metade do tamanho original -- e o buffer e criado uma vez so, apontando
+   // para os mesmos pixels, porque trocar a escala do vbscreen a cada quadro
