 // Desenha o quadrinho com a visao de outro jogador. Chamado depois da view
 // principal e antes do HUD, que fica por cima de proposito.
 //
+//
+// Posicao da saida do mapa, para o criterio "quem esta mais perto de sair".
+//
+// Calculada uma vez por mapa: percorre as linhas procurando os specials de
+// saida -- os mesmos que o bot reconhece em b_think -- e devolve o ponto medio
+// das que achou. Sem saida encontrada (mapa de fim de episodio, saida por
+// script), devolve false e o criterio cai de volta para o de abates.
+//
+static bool D_findExit(v2fixed_t &out)
+{
+   static int     cachedLevelTic = -1;
+   static bool    cachedFound;
+   static v2fixed_t cachedPos;
+
+   if(cachedLevelTic == levelstarttic)
+   {
+      out = cachedPos;
+      return cachedFound;
+   }
+
+   int64_t sumx = 0, sumy = 0;
+   int     count = 0;
+
+   for(int i = 0; i < numlines; i++)
+   {
+      const line_t &line = lines[i];
+      if(!line.special)
+         continue;
+
+      const ev_action_t *action = EV_ActionForSpecialOrGen(line.special);
+      if(!action)
+         continue;
+
+      const EVActionFunc func = action->action;
+      if(func != EV_ActionExitLevel        && func != EV_ActionSwitchExitLevel &&
+         func != EV_ActionGunExitLevel     && func != EV_ActionParamExitNormal &&
+         func != EV_ActionSecretExit       && func != EV_ActionSwitchSecretExit &&
+         func != EV_ActionParamExitSecret  && func != EV_ActionTeleportNewMap  &&
+         func != EV_ActionTeleportEndGame)
+      {
+         continue;
+      }
+
+      sumx += (line.v1->x + line.v2->x) / 2;
+      sumy += (line.v1->y + line.v2->y) / 2;
+      count++;
+   }
+
+   cachedLevelTic = levelstarttic;
+   cachedFound    = count > 0;
+   if(cachedFound)
+   {
+      cachedPos.x = static_cast<fixed_t>(sumx / count);
+      cachedPos.y = static_cast<fixed_t>(sumy / count);
+   }
+
+   out = cachedPos;
+   return cachedFound;
+}
