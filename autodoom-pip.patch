diff --git a/source/autodoom/b_vote.cpp b/source/autodoom/b_vote.cpp
new file mode 100644
index 00000000..763175c2
--- /dev/null
+++ b/source/autodoom/b_vote.cpp
@@ -0,0 +1,261 @@
+// Emacs style mode select   -*- C++ -*-
+//-----------------------------------------------------------------------------
+//
+// Copyright (C) 2026 AutoDoom contributors
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+//--------------------------------------------------------------------------
+//
+// DESCRIPTION:
+//   Exit approval. No bot ends the map on its own: the one who wants to leave
+//   asks, with the same yes/no prompt the engine uses for quitting. Say no and
+//   the level gets another minute before anyone asks again.
+//
+//   An earlier version had the bots vote among themselves on kill and item
+//   percentages. It always passed 3-0 -- with items at 100% every bot agreed
+//   regardless of the rest -- so it was a rubber stamp, not a decision. The one
+//   who cares whether the map is done is the person holding the keyboard, so
+//   the decision went there.
+//
+//-----------------------------------------------------------------------------
+
+#include "../z_zone.h"
+
+#include "../c_runcmd.h"
+#include "../d_gi.h"
+#include "../d_player.h"
+#include "../doomstat.h"
+#include "../g_game.h"
+#include "../hu_stuff.h"
+#include "../ev_actions.h"
+#include "../ev_specials.h"
+#include "../m_qstr.h"
+#include "../mn_misc.h"
+#include "../s_sound.h"
+#include "b_think.h"
+#include "b_vote.h"
+
+// Diario em vote.log, ao lado do executavel. Serve para conferir o que
+// aconteceu quando a pergunta some da tela antes de alguem ver.
+int bot_exitvote_log = 0;
+
+static void B_voteLog(const char *fmt, ...)
+{
+   if(!bot_exitvote_log)
+      return;
+
+   FILE *f = fopen("vote.log", "a");
+   if(!f)
+      return;
+
+   va_list args;
+   va_start(args, fmt);
+   fprintf(f, "[tic %7d] ", gametic);
+   vfprintf(f, fmt, args);
+   fputc(10, f);
+   va_end(args);
+   fclose(f);
+}
+
+// Fogo amigo entre jogadores no coop. Ligado = comportamento classico do Doom.
+int bot_friendlyfire = 1;
+
+int bot_exitvote       = 1;    // liga o pedido de autorizacao
+int bot_exitvote_delay = 60;   // segundos de espera depois de um "nao"
+
+// Pergunta sem resposta conta como recusa depois deste tempo. Sem isso, fechar
+// o dialogo por outro caminho deixaria a saida travada para sempre.
+static const int ANSWER_TIMEOUT_SECONDS = 30;
+
+static bool s_approved;      // saida ja liberada nesta partida
+static bool s_asking;        // pergunta na tela agora
+static int  s_askDeadline;   // gametic em que a pergunta expira
+static int  s_blockedUntil;  // gametic ate o qual ninguem pergunta de novo
+
+void B_VoteMapInit()
+{
+   B_voteLog("--- mapa novo ---");
+   s_approved     = false;
+   s_asking       = false;
+   s_askDeadline  = 0;
+   s_blockedUntil = 0;
+}
+
+//
+// A linha termina o mapa? Mesma lista que o bot usa para reconhecer saida.
+//
+bool B_LineIsExit(const line_t &line)
+{
+   if(!line.special)
+      return false;
+
+   const ev_action_t *action = EV_ActionForSpecialOrGen(line.special);
+   if(!action)
+      return false;
+
+   const EVActionFunc func = action->action;
+   return func == EV_ActionExitLevel       || func == EV_ActionSwitchExitLevel ||
+          func == EV_ActionGunExitLevel    || func == EV_ActionParamExitNormal ||
+          func == EV_ActionSecretExit      || func == EV_ActionSwitchSecretExit ||
+          func == EV_ActionParamExitSecret || func == EV_ActionTeleportNewMap  ||
+          func == EV_ActionTeleportEndGame;
+}
+
+bool B_ExitApproved()
+{
+   return !bot_exitvote || s_approved;
+}
+
+//
+// Percentual do mapa limpo, so para a pergunta dizer algo util. -1 quando o
+// mapa nao tem o que contar.
+//
+static int B_teamPercent(bool kills)
+{
+   const int total = kills ? totalkills : totalitems;
+   if(total <= 0)
+      return -1;
+
+   int done = 0;
+   for(int i = 0; i < MAXPLAYERS; i++)
+   {
+      if(playeringame[i])
+         done += kills ? players[i].killcount : players[i].itemcount;
+   }
+
+   return done * 100 / total;
+}
+
+//
+// Resposta "sim": libera a saida de vez neste mapa.
+//
+static void B_answerYes()
+{
+   s_asking   = false;
+   s_approved = true;
+   B_voteLog("jogador respondeu SIM: saida liberada");
+   doom_printf("Exit approved.");
+}
+
+void B_CastHumanVote(bool yes)
+{
+   if(!s_asking)
+   {
+      doom_printf("Nobody is asking to leave.");
+      return;
+   }
+
+   if(yes)
+   {
+      B_answerYes();
+      return;
+   }
+
+   s_asking       = false;
+   s_blockedUntil = gametic + bot_exitvote_delay * TICRATE;
+   B_voteLog("jogador respondeu NAO: mais %d segundos", bot_exitvote_delay);
+   doom_printf("Exit denied. %d more seconds down here.", bot_exitvote_delay);
+}
+
+bool B_RequestExitVote(int playernum)
+{
+   if(B_ExitApproved())
+      return true;
+
+   if(s_asking || gametic < s_blockedUntil)
+      return false;
+
+   s_asking      = true;
+   s_askDeadline = gametic + ANSWER_TIMEOUT_SECONDS * TICRATE;
+
+   const int kills = B_teamPercent(true);
+   const int items = B_teamPercent(false);
+
+   qstring question;
+   question << players[playernum].name << " wants to take the exit.";
+   if(kills >= 0)
+      question << "\n\nKills: " << kills << "%";
+   if(items >= 0)
+      question << (kills >= 0 ? "   Items: " : "\n\nItems: ") << items << "%";
+   question << "\n\nLet them go? (press y)";
+
+   B_voteLog("pergunta na tela: %s quer sair (mortes %d%%, itens %d%%)",
+             players[playernum].name, kills, items);
+   HU_Say(&players[playernum], "Found the exit. Can we go?");
+   MN_QuestionFunc(question.constPtr(), B_answerYes);
+   S_StartInterfaceSound(GameModeInfo->menuSounds[MN_SND_ACTIVATE]);
+
+   return false;
+}
+
+void B_VoteTicker()
+{
+   if(!bot_exitvote || !s_asking || gamestate != GS_LEVEL)
+      return;
+
+   // Silencio tambem e resposta: passado o prazo, vale como nao.
+   if(gametic >= s_askDeadline)
+   {
+      s_asking       = false;
+      s_blockedUntil = gametic + bot_exitvote_delay * TICRATE;
+      B_voteLog("pergunta expirou sem resposta");
+      doom_printf("No answer. Asking again in %d seconds.", bot_exitvote_delay);
+   }
+}
+
+// ----------------------------------------------------------------- console
+
+VARIABLE_BOOLEAN(bot_exitvote_log, nullptr, onoff);
+CONSOLE_VARIABLE(bot_exitvote_log, bot_exitvote_log, 0) {}
+
+VARIABLE_BOOLEAN(bot_friendlyfire, nullptr, onoff);
+CONSOLE_VARIABLE(bot_friendlyfire, bot_friendlyfire, 0) {}
+
+VARIABLE_BOOLEAN(bot_exitvote, nullptr, onoff);
+CONSOLE_VARIABLE(bot_exitvote, bot_exitvote, 0) {}
+
+VARIABLE_INT(bot_exitvote_delay, nullptr, 5, 600, nullptr);
+CONSOLE_VARIABLE(bot_exitvote_delay, bot_exitvote_delay, 0) {}
+
+//
+// Destrava todos os bots de uma vez.
+//
+CONSOLE_COMMAND(bot_unstick, 0)
+{
+   if(gamestate != GS_LEVEL)
+      return;
+
+   int shoved = 0;
+   for(int i = 0; i < MAXPLAYERS; i++)
+   {
+      if(playeringame[i] && bots[i].active && players[i].mo)
+      {
+         bots[i].shove(20);   // pouco mais de meio segundo
+         shoved++;
+      }
+   }
+
+   if(shoved)
+      doom_printf("Shoved %d bot%s loose.", shoved, shoved == 1 ? "" : "s");
+}
+
+CONSOLE_COMMAND(vote_yes, 0)
+{
+   B_CastHumanVote(true);
+}
+
+CONSOLE_COMMAND(vote_no, 0)
+{
+   B_CastHumanVote(false);
+}
+
+// EOF
