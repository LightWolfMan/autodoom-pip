+//
+// D_drawPipView
+//
+// Desenha o quadrinho com a visao de outro jogador. Chamado depois da view
+// principal e antes do HUD, que fica por cima de proposito.
+//
+static void D_drawPipView()
+{
+   if(!pip_active || gamestate != GS_LEVEL || automapactive)
+      return;
+
+   // Ranking por fragos/mortes: quem mais mata aparece primeiro. E o criterio
+   // automatico; o F12 empresta o lugar por 10 segundos e depois devolve.
+   int order[MAXPLAYERS];
+   int count = 0;
+
+   for(int i = 0; i < MAXPLAYERS; i++)
+   {
+      if(playeringame[i] && i != displayplayer && players[i].mo)
+         order[count++] = i;
+   }
+
+   if(!count)
+      return;
+
+   for(int a = 0; a < count - 1; a++)
+   {
+      for(int b = a + 1; b < count; b++)
+      {
+         if(players[order[b]].killcount > players[order[a]].killcount)
+         {
+            const int swap = order[a];
+            order[a] = order[b];
+            order[b] = swap;
+         }
+      }
+   }
+
+   // Escolha manual do F12 vale enquanto o prazo nao vence, e so no primeiro
+   // quadrinho -- os outros seguem o ranking.
+   if(gametic < pip_manual_until && pip_player >= 0 && pip_player < MAXPLAYERS &&
+      playeringame[pip_player] && pip_player != displayplayer)
+   {
+      for(int i = 0; i < count; i++)
+      {
+         if(order[i] == pip_player)
+         {
+            const int swap = order[0];
+            order[0] = order[i];
+            order[i] = swap;
+            break;
+         }
+      }
+   }
+   else if(gametic >= pip_manual_until)
+      pip_player = order[0];   // volta sozinho para quem mais mata
+
+   int boxes = pip_count;
+   if(boxes > count)
+      boxes = count;
+   if(boxes < 1)
+      boxes = 1;
+
+   const int margin = video.width / 64;
+   int w = video.width  * pip_size / 100;
+   int h = video.height * pip_size / 100;
+   w &= ~1;
+   h &= ~1;
+
+   // Nao deixa a fila estourar a largura da tela.
+   while(boxes > 1 && margin + boxes * (w + margin) > video.width)
+      boxes--;
+
+   const int y = pip_bottom ? video.height - h - margin : margin;
+
+   for(int n = 0; n < boxes; n++)
+   {
+      const int x = margin + n * (w + margin);   // sempre da esquerda para a direita
+
+      V_ColorBlock(&vbscreen, GameModeInfo->blackIndex, x - 1, y - 1, w + 2, 1);
+      V_ColorBlock(&vbscreen, GameModeInfo->blackIndex, x - 1, y + h,  w + 2, 1);
+      V_ColorBlock(&vbscreen, GameModeInfo->blackIndex, x - 1, y - 1, 1, h + 2);
+      V_ColorBlock(&vbscreen, GameModeInfo->blackIndex, x + w,  y - 1, 1, h + 2);
+
+      R_RenderPipView(&players[order[n]], x, y, w, h);
+   }
+}
