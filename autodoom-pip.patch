 //
 // Primary renderer entry point.
 //
+//
+// PIP -- picture-in-picture: a visao de outro jogador num quadrinho no canto.
+//
+// Funciona porque R_RenderPlayerView limpa todos os buffers dele na entrada
+// (clip segs, draw segs, planos, portais, sprites), entao chamar duas vezes no
+// mesmo quadro e seguro. O que precisa de cuidado e a geometria: viewwindow,
+// os centros, o struct view e a tabela de altura por coluna. Tudo isso e
+// salvo, trocado pelo retangulo do PIP e devolvido no fim.
+//
+int pip_active = 0;   // liga/desliga
+int pip_size   = 25;  // porcentagem da tela, por quadrinho
+int pip_bottom = 0;   // 0 = fila em cima, 1 = fila embaixo
+int pip_count  = 1;   // quantos quadrinhos, da esquerda para a direita
+int pip_player = -1;  // escolhido a mao pelo F12; -1 = automatico
+int pip_manual_until = 0; // ate que gametic a escolha manual manda
+
+void R_RenderPipView(player_t *player, int x, int y, int w, int h)
+{
+   if(!player || !player->mo || w < 32 || h < 32)
+      return;
+
+   const rrect_t   savedWindow  = viewwindow;
+   const cb_view_t savedView    = view;
+   const int       savedCenterX = centerx;
+   const int       savedCenterY = centery;
+   const fixed_t   savedCXFrac  = centerxfrac;
+   const fixed_t   savedCYFrac  = centeryfrac;
+
+   viewwindow.x      = x;
+   viewwindow.y      = y;
+   viewwindow.width  = w;
+   viewwindow.height = h;
+
+   centerx     = w / 2;
+   centery     = h / 2;
+   centerxfrac = centerx << FRACBITS;
+   centeryfrac = centery << FRACBITS;
+
+   view.xcenter = (view.width  = (float)w) * 0.5f;
+   view.ycenter = (view.height = (float)h) * 0.5f;
+
+   // A arma do outro jogador tem que encolher junto, senao vira um canhao
+   // ocupando o quadrinho inteiro.
+   const float shrinkX = (float)w / (float)savedWindow.width;
+   const float shrinkY = (float)h / (float)savedWindow.height;
+   view.pspritexscale *= shrinkX;
+   view.pspriteyscale *= shrinkY;
+   view.pspriteystep   = 1.0f / view.pspriteyscale;
+
+   R_InitTextureMapping();
+   for(int i = 0; i < w; i++)
+      screenheightarray[i] = view.height - 1.0f;
+
+   R_RenderPlayerView(player, nullptr);
+
+   viewwindow  = savedWindow;
+   view        = savedView;
+   centerx     = savedCenterX;
+   centery     = savedCenterY;
+   centerxfrac = savedCXFrac;
+   centeryfrac = savedCYFrac;
+
+   R_InitTextureMapping();
+   for(int i = 0; i < viewwindow.width; i++)
+      screenheightarray[i] = view.height - 1.0f;
+}
